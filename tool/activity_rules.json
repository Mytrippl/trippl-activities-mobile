{
  "ActivityCoordinate": "if(latitude< -90 || latitude>90 || longitude< -180 || longitude>180)",
  "ActivityAddress": "if(countryCode!=null&&!RegExp(r'^[A-Z]{2}$').hasMatch(countryCode!))",
  "ActivityAttribution": "if(!{'provider','photo','review','author','license'}.contains(kind) || uri!=null&&(Uri.tryParse(uri!)?.scheme!='https'||Uri.tryParse(uri!)!.host.isEmpty||Uri.tryParse(uri!)!.userInfo.isNotEmpty))",
  "ActivityPhoto": "if(Uri.tryParse(url)?.scheme!='https'||Uri.tryParse(url)!.host.isEmpty||Uri.tryParse(url)!.userInfo.isNotEmpty||width!=null&&(width!<1||width!>20000)||height!=null&&(height!<1||height!>20000)||observedAt!=null&&expiresAt!=null&&!expiresAt!.isAfter(observedAt!))",
  "ActivityReview": "if(rating!=null&&(rating!<0||rating!>5))",
  "ActivityRating": "if(maximum!=5||value!=null&&(value!<0||value!>5))",
  "ActivityDuration": "if(minimumMinutes!=null&&minimumMinutes!>43200||maximumMinutes!=null&&maximumMinutes!>43200||fixedMinutes!=null&&(fixedMinutes!<1||fixedMinutes!>43200)||minimumMinutes!=null&&maximumMinutes!=null&&minimumMinutes!>maximumMinutes!)",
  "ActivityGuideLanguage": "if(!RegExp(r'^[a-z]{2,3}(?:-[A-Za-z]{2,4})?$').hasMatch(code)||!{'guide','audio','written'}.contains(kind))",
  "ActivityAgeBand": "if(!{'adult','senior','youth','child','infant','traveler'}.contains(category)||startAge>120||endAge>120||endAge<startAge||minimumTravelers>100||maximumTravelers!=null&&(maximumTravelers!>100||maximumTravelers!<minimumTravelers))",
  "ActivityTraveler": "if(age>120)",
  "ActivityTravelerMix": "if(revision<1||minimumTravelers<1||maximumTravelers>100||minimumTravelers>maximumTravelers||travelers.map((t)=>t.id).toSet().length!=travelers.length||!{'perPerson','perGroup','perUnit','unknown'}.contains(pricingBasis))",
  "ActivityEligibility": "if(totalTravelers>100||capacityTravelers>totalTravelers||assignedCategories.length>totalTravelers)",
  "ActivityMoney": "if(!RegExp(r'^[A-Z]{3}$').hasMatch(currency)||decimals>4)",
  "ActivityPriceComponent": "if(quantity<1||quantity>100||!{'base','tax','fee','discount'}.contains(kind))",
  "ActivityPriceRule": "if(!{'perPerson','perGroup','perUnit'}.contains(basis)||minimumTravelers<1||maximumTravelers>100||minimumTravelers>maximumTravelers||minimumUnits<1||minimumUnits>100||maximumUnits!=null&&(maximumUnits!>100||maximumUnits!<minimumUnits)||priority>1000)",
  "ActivityPriceQuote": "if(revision<1||!expiresAt.isAfter(observedAt)||!RegExp(r'^[a-f0-9]{64}$').hasMatch(requestFingerprint))",
  "ActivityPriceBreakdown": "if(travelerCount<1||travelerCount>100||!{'perPerson','perGroup','perUnit','unknown'}.contains(basis))",
  "ActivityCancellationTier": "if(refundBasisPoints>10000)",
  "ActivityCancellationPolicy": "if(!{'unknown','standard','custom','nonRefundable'}.contains(kind)||observedAt!=null&&expiresAt!=null&&!expiresAt!.isAfter(observedAt!)||tiers.map((t)=>t.id).toSet().length!=tiers.length)",
  "ActivityCancellationAssessment": "if(!{'unknown','free','partial','nonRefundable','expired'}.contains(state))",
  "ActivityMeetingPoint": "if(arrivalMinutesBefore>1440)",
  "ActivityPickup": "if(pointIds.toSet().length!=pointIds.length||included&&!available)",
  "ActivityInclusion": "if(!{'admission','transport','guide','food','equipment','other'}.contains(category))",
  "ActivityOption": "if(minimumTravelers<1||maximumTravelers>100||minimumTravelers>maximumTravelers||priceRules.map((p)=>p.id).toSet().length!=priceRules.length)",
  "ActivityProduct": "if(revision<1||observedAt!=null&&expiresAt!=null&&!expiresAt!.isAfter(observedAt!)||options.any((o)=>o.productId!=id)||options.map((o)=>o.id).toSet().length!=options.length)"
}
